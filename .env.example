# Скопируйте в .env и заполните. .env уже в .gitignore — токен не попадёт в репозиторий.
# Приоритет: реальные переменные окружения > этот файл > значения по умолчанию.

# Токен бота от @BotFather (обязателен в сервисном режиме)
TELEGRAM_TOKEN=

# Telegram-id админа (число): заявки на доступ, алерты, /monitor, /restart*
TELEGRAM_ACCESS_ID=

# Postgres (в docker compose подставляется автоматически; локальная разработка —
# при поднятом контейнере: postgresql://moon@127.0.0.1:5433/sky)
#MOONOBSRV_DB=postgresql://moon@127.0.0.1:5433/sky

# Telegram API через Tor (в prod-compose подставляется автоматически)
#MOONOBSRV_TOR=socks5://127.0.0.1:9050

# Проект docker compose для /monitor и /restart* (moonobsrv)
#MOONOBSRV_COMPOSE_PROJECT=moonobsrv

# Каталог состояния (по умолчанию data; в контейнере — /data)
#MOONOBSRV_DATA_DIR=data

# Часовой пояс вывода в часах: 3, -5, 5.5 (по умолчанию 3 — Москва)
#MOONOBSRV_TZ=3

# Long polling, сек (25)
#MOONOBSRV_POLL_TIMEOUT=25

# Период проверки неба, сек (60)
#MOONOBSRV_CHECK_INTERVAL=60

# === Режим webhook (по умолчанию — long polling) ===
#MOONOBSRV_WEBHOOK_URL=https://bot.example.com/tg/secret-path
#MOONOBSRV_LISTEN=127.0.0.1:8080
#MOONOBSRV_WEBHOOK_SECRET=длинная-случайная-строка

# Путь к альтернативному env-файлу вместо .env
#MOONOBSRV_ENV=/path/to/prod.env
