# Скопируйте в .env и заполните. .env уже в .gitignore — токен не попадёт в репозиторий.
# Приоритет: реальные переменные окружения > этот файл > значения по умолчанию.

# Токен бота от @BotFather (обязателен в сервисном режиме)
TELEGRAM_TOKEN=

# Каталог состояния (по умолчанию data)
#MOONOBSRV_DATA_DIR=data

# Часовой пояс вывода в часах: 3, -5, 5.5 (по умолчанию 3 — Москва)
#MOONOBSRV_TZ=3

# Long polling, сек (25)
#MOONOBSRV_POLL_TIMEOUT=25

# Период проверки неба, сек (60)
#MOONOBSRV_CHECK_INTERVAL=60

# === Режим webhook (по умолчанию — long polling) ===
# Публичный https-адрес, на который Telegram будет присылать обновления.
# Задание этой переменной включает webhook-режим. Требуется TLS-терминатор
# спереди (caddy/nginx/облачный балансировщик) — см. README.
#MOONOBSRV_WEBHOOK_URL=https://bot.example.com/tg/secret-path

# Где слушать HTTP локально (адрес, который пробрасывает терминатор)
#MOONOBSRV_LISTEN=127.0.0.1:8080

# Секрет webhook: Telegram будет дублировать его в заголовке каждого запроса
#MOONOBSRV_WEBHOOK_SECRET=длинная-случайная-строка-A-Za-z0-9_-

# Путь к альтернативному env-файлу вместо .env (считывается только из реального окружения)
#MOONOBSRV_ENV=C:\path\to\prod.env
